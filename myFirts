<dialog id="modal" aria-labelledby="mt">
  <div class="mb">
    <h2 id="mt">Book a consultation</h2>
    <p class="s">Tell us a little and we’ll reply within one working day.</p>
    <form id="form" novalidate>
      <label class="f">Name<input id="n" name="name" type="text" autocomplete="name" required></label>
      <label class="f">Email<input id="e" name="email" type="email" autocomplete="email" required></label>
      <label class="f">Room<select name="room"><option>Living room</option><option>Bedroom</option><option>Kitchen</option><option>Bathroom</option><option>Office</option><option>Commercial space</option></select></label>
      <label class="f">Preferred date<input name="date" type="date"></label>
      <div class="act"><button class="go" type="submit">Send request</button><button class="no" type="button" data-close>Cancel</button></div>
    </form>
    <div class="ok"><p>Thank you. We’ll reply within one working day.</p><button class="go btn" data-close style="background:var(--btn);color:var(--btnink)">Close</button></div>
  </div>
</dialog>

<script>
(function(){
  var m=document.getElementById('modal'),f=document.getElementById('form');
  function open(){m.classList.remove('sent');f.reset();m.showModal();document.getElementById('n').focus()}
  function close(){m.close()}
  document.querySelectorAll('[data-open]').forEach(function(b){b.addEventListener('click',open)});
  m.addEventListener('click',function(e){if(e.target===m||e.target.hasAttribute('data-close'))close()});
  f.addEventListener('submit',function(e){
    e.preventDefault();
    var n=document.getElementById('n'),em=document.getElementById('e');
    n.style.borderBottomColor=n.value.trim()?'':'#b3402f';
    var ok=/^\S+@\S+\.\S+$/.test(em.value);
    em.style.borderBottomColor=ok?'':'#b3402f';
    if(!n.value.trim()){n.focus();return}
    if(!ok){em.focus();return}
    m.classList.add('sent');
  });

  var btns=document.querySelectorAll('.filters button'),cards=document.querySelectorAll('#grid .card');
  btns.forEach(function(b){b.addEventListener('click',function(){
    btns.forEach(function(x){x.setAttribute('aria-pressed',x===b)});
    var k=b.dataset.f;
    cards.forEach(function(c){c.hidden=!(k==='all'||c.dataset.c===k)});
  })});

  var cmp=document.getElementById('cmp'),knob=document.getElementById('knob'),drag=false;
  function set(p){p=Math.max(2,Math.min(98,p));cmp.style.setProperty('--p',p+'%');knob.setAttribute('aria-valuenow',Math.round(p))}
  function at(x){var r=cmp.getBoundingClientRect();set((x-r.left)/r.width*100)}
  cmp.addEventListener('pointerdown',function(e){drag=true;cmp.setPointerCapture(e.pointerId);at(e.clientX)});
  cmp.addEventListener('pointermove',function(e){if(drag)at(e.clientX)});
  ['pointerup','pointercancel'].forEach(function(t){cmp.addEventListener(t,function(){drag=false})});
  knob.addEventListener('keydown',function(e){
    var v=parseFloat(knob.getAttribute('aria-valuenow'));
    if(e.key==='ArrowLeft'){set(v-4);e.preventDefault()}
    if(e.key==='ArrowRight'){set(v+4);e.preventDefault()}
  });
})();
</script>
</body>
</html>
