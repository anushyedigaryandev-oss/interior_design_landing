<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Forma Studio — Interior Design Studio</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@300;400;500&family=Newsreader:opsz,wght@6..72,300;400&display=swap" rel="stylesheet">
<style>
:root{--bg:#f3f2ef;--ink:#1b1a19;--muted:#6f6b66;--line:#d9d6d0;--tile:#e6e4e0;--dark:#2c2c2e;--footer:#1c1c1c;--paper:#fff;--paperink:#2a2a2a;--btn:#2a2a2a;--btnink:#fff;
--serif:"Newsreader","Cormorant Garamond",Georgia,serif;--sans:"Hanken Grotesk",system-ui,-apple-system,"Segoe UI",sans-serif;
box-sizing:border-box;color-scheme:light}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
*,*::before,*::after{box-sizing:inherit}
body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--sans);font-weight:300;line-height:1.6;-webkit-font-smoothing:antialiased}
body:has(dialog[open]){overflow:hidden}
img{display:block;max-width:100%}
a{color:inherit;text-decoration:none}
button{font:inherit;cursor:pointer}
.wrap{width:min(1200px,100% - 48px);margin-inline:auto}
.ar{width:15px;height:15px;flex:none}
h1,h2,h3{font-family:var(--serif);font-weight:300;margin:0;letter-spacing:-.01em;line-height:1.1}
.eyebrow{font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:var(--muted);margin:0 0 14px}
.btn{display:inline-flex;align-items:center;gap:22px;padding:15px 22px;font-size:13px;font-weight:400;border:0;background:var(--btn);color:var(--btnink);transition:opacity .2s}
.btn:hover{opacity:.85}
.btn.light{background:#ece9e4;color:#1b1a19}
.btn.dark{background:#1b1a19;color:#f1eee9;}

/* hero */
.hero{position:relative;min-height:clamp(520px,42vw,600px);background:#1c1917;color:#f1eee9;overflow:hidden;isolation:isolate}
.hero::before{content:"";position:absolute;inset:0;background:url(data:image/jpeg;base64,) right center/cover;z-index:-2}
.hero::after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,#1c1917 0%,#1c1917 0%,rgba(28,25,23,.62) 0%,rgba(28,25,23,.18) 100%),linear-gradient(180deg,rgba(0,0,0,.45),transparent 30%);z-index:-1}
.nav{display:flex;align-items:center;justify-content:space-between;padding-top:28px;position:relative}
.logo{font-family:var(--serif);font-size:30px;letter-spacing:.08em;line-height:1;display:inline-flex;flex-direction:column;}
.logo small{font-family:var(--sans);font-size:8px;letter-spacing:.3em;margin-top:5px;opacity:.7;}
.nav ul{display:flex;gap:44px;list-style:none;margin:0;padding:0;position:absolute;left:50%;transform:translateX(-50%);font-size:13px}
.nav ul a{opacity:.85}.nav ul a:hover{opacity:1}
.hero-side{position:absolute;right:0;top:92px;text-align:right;font-size:12px;line-height:1.9;opacity:.72}
.hero-body{padding:clamp(56px,8vw,96px) 0 80px;max-width:520px}
.hero .eyebrow{color:rgba(241,238,233,.8)}
.hero h1{font-size:clamp(44px,5vw,64px);margin-bottom:22px;color:#f1eee9;}
.hero p.lead{font-size:15px;max-width:340px;margin:0 0 30px;opacity:.9}
.scroll{display:inline-flex;align-items:center;gap:12px;font-size:12px;margin-top:28px;opacity:.85}
.scroll i{width:16px;height:26px;border:1px solid rgba(255,255,255,.7);border-radius:9px;position:relative}
.scroll i::after{content:"";position:absolute;left:50%;top:6px;width:2px;height:5px;margin-left:-1px;background:#fff;border-radius:2px}

/* projects */
.projects{padding:72px 0 88px}
.ph{display:flex;align-items:flex-end;justify-content:space-between;gap:24px;flex-wrap:wrap;margin-bottom:34px}
.ph h2{font-size:clamp(36px,3.6vw,46px);color: var(--dark);}
.filters{display:flex;flex-wrap:wrap;gap:6px 34px;font-size:14px}
.filters button{background:none;border:0;padding:4px 0 8px;color:var(--muted);border-bottom:1px solid transparent}
.filters button[aria-pressed="true"]{color:var(--ink);border-color:var(--ink)}
.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:28px 20px}
.card[hidden]{display:none}
.card img{width:100%;aspect-ratio:201/143;object-fit:cover}
.card div{display:flex;justify-content:space-between;align-items:center;padding-top:12px;font-size:14px;font-weight:400}
.card span{display:block;font-size:11px;font-weight:300;color:var(--muted);margin-top:1px}
.quote{background:var(--tile);display:flex;align-items:center;padding:30px 32px;font-family:var(--serif);font-size:19px;line-height:1.45;aspect-ratio:201/143}
.quote p{margin:0;max-width:170px}

/* how we work (from supplied block) */
.how{background:var(--dark);color:#f2f0ec;padding:88px 0 110px}
.how h2{font-size:clamp(44px,5vw,66px);font-weight:300;margin-bottom:34px;color: #f1eee9;}
.how .sub{color:#b3aea6;font-size:15px;max-width:470px;margin:0 0 56px}
.steps{display:grid;grid-template-columns:repeat(5,1fr);list-style:none;margin:0;padding:0;border-top:1px solid #4a4a4d}
.steps li{position:relative;padding:30px 24px 0 0}
.steps li::before{content:"";position:absolute;top:-1px;left:0;width:28px;height:2px;background:#f1eee9}
.steps small{display:block;font-size:12px;color:#97938d;margin-bottom:6px}
.steps h3{font-size:25px;margin-block:12px;color:#b3aea6}
.steps p{margin:0;font-size:14px;line-height:1.7;color:#b3aea6}

/* before / after */
.ba{padding:84px 0 92px}
.ba .wrap{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.9fr);gap:clamp(32px,5vw,64px);align-items:center}
.ba h2{font-size:clamp(36px,3.6vw,46px);margin-bottom:22px;color: var(--dark);}
.ba h2 em{font-style:italic;font-weight:300}
.ba p{font-size:14px;color:var(--muted);max-width:240px;margin:0 0 26px}
.ba .more{display:inline-flex;gap:14px;align-items:center;font-size:13px;border-bottom:1px solid var(--ink);padding-bottom:2px;color: #1b1a19;}
.cmp{position:relative;aspect-ratio:572/167;overflow:hidden;user-select:none;touch-action:pan-y;cursor:ew-resize;--p:48.5%}
.cmp img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;pointer-events:none}
.cmp .after{clip-path:inset(0 0 0 var(--p))}
.tag{position:absolute;bottom:0;padding:8px 14px;font-size:11px;color:#fff;background:rgba(24,22,20,.82)}
.tag.b{left:12px;bottom:12px}.tag.a{right:12px;bottom:12px}
.knob{position:absolute;top:0;bottom:0;left:var(--p);width:2px;margin-left:-1px;background:#fff}
.knob button{position:absolute;top:50%;left:50%;width:36px;height:36px;margin:-18px 0 0 -18px;border-radius:50%;border:0;background:#f4f2ee;color:#1b1a19;display:grid;place-items:center;box-shadow:0 2px 10px rgba(0,0,0,.25);cursor:ew-resize}
.knob button:focus-visible{outline:2px solid #1b1a19;outline-offset:3px}

/* cta + footer */
.cta{position:relative;isolation:isolate;color:#f1eee9;background:#2a2522;padding:54px 0;overflow:hidden}
.cta::before{content:"";position:absolute;inset:0 0 0 25%;background:url(data:image/jpeg;base64,) center/cover;z-index:-2}
.cta::after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,#2a2522 15%,rgba(42,37,34,.55) 60%,rgba(42,37,34,.7));z-index:-1}
.cta .wrap{display:flex;align-items:center;justify-content:space-between;gap:28px;flex-wrap:wrap}
.cta .eyebrow{color:#b3aea6;margin-bottom:10px}
.cta h2{font-size:clamp(34px,3.4vw,44px);margin-bottom:8px;color:#f1eee9;}
.cta p{margin:0;font-size:13px;opacity:.85;color: #b3aea6;}
footer{background:var(--footer);color:#d9d5ce;padding:44px 0 36px;font-size:12px}
footer .wrap{display:grid;grid-template-columns:1fr auto 1fr;gap:24px;align-items:start}
footer .logo{font-size:26px}
footer ul{display:flex;gap:32px;list-style:none;margin:0;padding:0}
.soc{display:flex;gap:16px;align-items:center}
.soc a{width:20px;height:20px;display:block;opacity:.8}
.fr{text-align:right;line-height:1.9;display:flex;flex-direction:column;align-items:flex-end;gap:18px}
.copy{grid-column:1/-1;opacity:.5;font-size:11px;margin:10px 0 0}
.addr{display:flex;gap:28px;align-items:flex-start}

/* modal */
dialog{overflow:auto;border:0;padding:0;background:var(--paper);color:var(--paperink);width:min(483px,100% - 32px);max-height:calc(100% - 32px);box-shadow:0 24px 80px rgba(0,0,0,.35);animation:pop .22s ease-out}
dialog::backdrop{background:rgba(20,18,16,.55);backdrop-filter:blur(2px)}
@keyframes pop{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
.mb{padding:30px 38px 36px}
.mb h2{font-size:36px;margin-bottom:12px}
.mb .s{margin:0 0 26px;color:var(--muted);font-size:15px}
.f{display:block;margin-bottom:6px;font-size:13px;color:var(--muted)}
.f input,.f select{display:block;width:100%;padding:8px 0 12px;border:0;border-bottom:1px solid var(--line);background:transparent;color:var(--paperink);font:400 16px var(--sans);border-radius:0;outline:0;color-scheme:light dark}
.f select{border-bottom-color:var(--paperink)}
.f input:focus{border-bottom-color:var(--paperink);box-shadow: none;}
.f select:focus{box-shadow: none;}
.f{margin-bottom:14px}
.act{display:flex;align-items:center;gap:30px;margin-top:22px}
.act .go{padding:17px 26px;background:#2a2a2a;color:#fff;border:0;font-weight:500;font-size:15px}
.act .no{background:none;border:0;color:var(--muted);font-size:15px;padding:0}
.ok{display:none;padding:12px 0 6px}
.ok p{color:var(--muted);margin:0 0 24px}
dialog.sent form{display:none}dialog.sent .ok{display:block}

@media (max-width:960px){
.nav ul{display:none}.hero-side{display:none}
.grid{grid-template-columns:repeat(2,1fr)}
.steps{grid-template-columns:repeat(2,1fr);border-top:0}
.steps li{border-top:1px solid #4a4a4d;margin-bottom:32px}
.ba .wrap{grid-template-columns:1fr}.ba p{max-width:420px}
footer .wrap{grid-template-columns:1fr}.fr{align-items:flex-start;text-align:left}footer ul{flex-wrap:wrap}
}
@media (max-width:560px){
.grid{gap:22px 14px}.steps{grid-template-columns:1fr}
.cmp{aspect-ratio:4/3}
.mb{padding:26px 24px 30px}.filters{gap:4px 22px}
.hero::before{inset:0}
}

footer .wrap>*{min-width:0}
@media (max-width:960px){
.quote{aspect-ratio:auto;min-height:150px}
}
@media (max-width:560px){
.wrap{width:calc(100% - 36px)}
.nav{padding-top:20px}
.logo{font-size:26px}
.nav .btn{padding:11px 14px;gap:10px;font-size:12px}
.hero{min-height:0}
.hero::before{inset:0}
.hero::after{background:linear-gradient(180deg,rgba(28,25,23,.62),rgba(28,25,23,.9))}
.hero-body{padding:52px 0 52px}
.hero h1{font-size:42px}
.hero p.lead{max-width:none}
.projects{padding:56px 0 64px}
.card div{font-size:13px;gap:6px}
.card .ar{width:13px;height:13px}
.quote{padding:18px;font-size:16px;min-height:0;aspect-ratio:auto}
.quote p{max-width:none}
.how{padding:64px 0 56px}
.how .sub{margin-bottom:40px}
.ba{padding:56px 0 64px}
.cta::before{inset:0}
.cta .btn{width:100%;justify-content:space-between}
footer{padding:40px 0 36px}
footer ul{gap:12px 22px}
.addr{flex-direction:column;gap:14px}
.act{flex-wrap:wrap;gap:16px 24px}
dialog{max-height:calc(100dvh - 24px)}
}
</style>
</head>
